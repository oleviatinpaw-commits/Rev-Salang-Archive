<script>
(function () {
  'use strict';

  var form = document.getElementById('memory-form');
  var sent = document.getElementById('sent');

  form.addEventListener('submit', function (e) {
    var action = form.getAttribute('action') || '';

    // Not wired up yet — show the preview message instead.
    if (action.indexOf('REPLACE_WITH_YOUR_ID') !== -1) {
      e.preventDefault();
      sent.hidden = false;
      sent.textContent = 'Thank you. This is a preview of the site, so your memory was not sent yet.';
      return;
    }

    // Wired up — submit without a page reload.
    e.preventDefault();
    var data = new FormData(form);
    sent.hidden = false;
    sent.textContent = 'Sending…';

    fetch(action, {
      method: 'POST',
      body: data,
      headers: { Accept: 'application/json' }
    })
      .then(function (res) {
        if (res.ok) {
          form.reset();
          sent.textContent = 'Thank you. Your memory has been sent to the family.';
        } else {
          sent.textContent = 'Something went wrong. Please try again, or email the family directly.';
        }
      })
      .catch(function () {
        sent.textContent = 'Something went wrong. Please try again, or email the family directly.';
      });
  });
})();
</script>

